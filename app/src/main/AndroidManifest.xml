<?xml version="1.0" encoding="utf-8"?>
<!-- Created by Notch -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application android:name=".WammyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Wammy">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wammy" android:host="anilist-auth" />
                <data android:scheme="wammy" android:host="mal-auth" />
                <data android:scheme="wammy" android:host="kitsu-auth" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.reader.BrowseNovelActivity" android:exported="true" android:theme="@style/Theme.Wammy" />
            <activity android:name=".ui.reader.LNNovelDetailsActivity" android:exported="false" android:theme="@style/Theme.Wammy" />
        <activity
            android:name=".ui.reader.CloudflareBypassActivity"
            android:exported="false" />
            <activity android:name=".ui.reader.LNTextReaderActivity" android:exported="false" android:theme="@style/Theme.Wammy" />
    </application>

</manifest>
